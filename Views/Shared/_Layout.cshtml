<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <!-- Bootstrap 5 CDN for professional, responsive UI -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        /* Sporting, energetic RaceDay theme */
        body { background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .navbar { background: linear-gradient(90deg, #d32f2f 0%, #b71c1c 100%); } /* Energetic Red */
        .navbar-brand { font-weight: bold; font-size: 1.5rem; color: white !important; }
        .btn-race { background-color: #d32f2f; color: white; border: none; }
        .btn-race:hover { background-color: #b71c1c; color: white; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">🏃 RaceDay</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (Context.Session.GetString("Token") != null)
                        {
                            var role = Context.Session.GetString("Role");
                            <li class="nav-item"><a class="nav-link text-white" asp-controller="Home" asp-action="Index">Home</a></li>

                            @if (role == "Organiser")
                            {
                                <li class="nav-item"><a class="nav-link text-white" asp-controller="Events" asp-action="Dashboard">Dashboard</a></li>
                                <li class="nav-item"><a class="nav-link text-white" asp-controller="Events" asp-action="Create">Create Event</a></li>
                            }
                            else if (role == "Participant")
                            {
                                <li class="nav-item"><a class="nav-link text-white" asp-controller="Enrolments" asp-action="MyRaces">My Races</a></li>
                                <li class="nav-item"><a class="nav-link text-white" asp-controller="Results" asp-action="MyResults">My Results</a></li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (Context.Session.GetString("Token") != null)
                        {
                            <li class="nav-item"><span class="nav-link text-white">Hello, @Context.Session.GetString("Role")!</span></li>
                            <li class="nav-item"><a class="nav-link text-white" asp-controller="Account" asp-action="Logout">Logout</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link text-white" asp-controller="Account" asp-action="Login">Login</a></li>
                            <li class="nav-item"><a class="nav-link text-white" asp-controller="Account" asp-action="Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container text-center py-3">
            &copy; 2026 - RaceDay Platform 
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
@model List<RaceDay.MVC.Models.EventViewModel>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-danger fw-bold">Organiser Dashboard</h2>
    <a asp-action="Create" class="btn btn-race">+ Create New Event</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row">
    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow h-100">
                    <div class="card-body">
                        <h5 class="card-title fw-bold">@item.EventName</h5>
                        <p class="card-text text-muted">@item.Location | @item.EventDate.ToString("dd MMM yyyy")</p>
                        <p class="card-text">@item.Description</p>
                    </div>
                    <div class="card-footer bg-white border-0">
                        <a href="#" class="btn btn-outline-danger btn-sm">Manage Categories</a>
                        <a href="#" class="btn btn-outline-secondary btn-sm">View Enrolments</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12"><p class="text-muted">You haven't created any events yet.</p></div>
    }
</div>